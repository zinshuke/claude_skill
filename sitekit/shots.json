{
	"base_url": "http://localhost:3000",
	"viewport": {
		"width": 1440,
		"height": 900
	},
	"color": "#84cc16",
	"crop": {
		"padding": 60,
		"min_width": 800,
		"min_height": 400
	},
	"hide": [
		".phpdebugbar",
		"#system-debug"
	],
	"blur": [],
	"shots": [
		{
			"name": "byo-01-redirect-uri",
			"url": "/administrator/index.php?option=com_sitekit&view=settings",
			"highlights": [
				{
					"selector": ".mb-3:has(#redirect_uri)",
					"label": "1",
					"note": "Copy this URI into Google Cloud"
				}
			]
		},
		{
			"name": "byo-02-credentials",
			"url": "/administrator/index.php?option=com_sitekit&view=settings",
			"actions": [
				{
					"fill": [
						"#client_id",
						"123456789012-abc123def456.apps.googleusercontent.com"
					]
				},
				{
					"fill": [
						"#client_secret",
						"GOCSPX-example-secret"
					]
				}
			],
			"highlights": [
				{
					"selector": ".mb-3:has(#client_id)",
					"label": "2a",
					"note": "Paste the Client ID"
				},
				{
					"selector": ".mb-3:has(#client_secret)",
					"label": "2b",
					"note": "Paste the Client Secret"
				},
				{
					"selector": "#adminForm button[type=submit]",
					"label": "2c",
					"note": "Save your credentials"
				}
			]
		},
		{
			"name": "dash-01-menu",
			"url": "/administrator/index.php?option=com_sitekit&view=dashboard",
			"highlights": [
				{
					"selector": "#sidebarmenu a[href*=\"com_sitekit&view=dashboard\"]",
					"label": "1",
					"padding": 4,
					"note": "Open the SiteKit Dashboard"
				}
			]
		},
		{
			"name": "dash-02-setup",
			"url": "/administrator/index.php?option=com_sitekit&view=dashboard",
			"highlights": [
				{
					"selector": ".card:has(.com-sitekit-steps)",
					"label": "2",
					"note": "Follow these three setup steps"
				}
			]
		},
		{
			"name": "dash-03-status",
			"url": "/administrator/index.php?option=com_sitekit&view=dashboard",
			"highlights": [
				{
					"selector": ".col-md-4 .card",
					"label": "3",
					"note": "Credentials and Google sign-in"
