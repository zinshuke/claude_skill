					"note": "Totals and change"
				},
				{
					"selector": ".com-sitekit-report-card:not([hidden]) .com-sitekit-chart-panel",
					"label": "3b",
					"note": "Clicks and impressions per day"
				},
				{
					"selector": ".com-sitekit-report-card:not([hidden]) .com-sitekit-tables-grid",
					"label": "3c",
					"note": "Top searches and pages"
				}
			]
		},
		{
			"name": "rep-04-tools",
			"url": "/administrator/index.php?option=com_sitekit&view=reports",
			"settle_ms": 2500,
			"actions": [
				{
					"select": [
						"#sitekit-report-picker",
						"searchconsole"
					]
				},
				{
					"click": "[data-sitekit-load-report]"
