					"badge": "right",
					"note": "Connected, report ready"
				}
			]
		},
		{
			"name": "rep-03-sc-report",
			"url": "/administrator/index.php?option=com_sitekit&view=reports",
			"settle_ms": 2500,
			"actions": [
				{
					"select": [
						"#sitekit-report-picker",
						"searchconsole"
					]
				},
				{
					"click": "[data-sitekit-load-report]"
				},
				{
					"wait": ".com-sitekit-report-card:not([hidden]) .com-sitekit-metric-grid"
