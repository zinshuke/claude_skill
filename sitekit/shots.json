			],
			"highlights": [
				{
					"selector": "[data-sitekit-dashboard-sc]",
					"label": "5",
					"note": "Search traffic, last 28 days"
				}
			]
		},
		{
			"name": "sc-03-connected",
			"url": "/administrator/index.php?option=com_sitekit&view=services",
			"highlights": [
