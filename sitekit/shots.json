					"note": "Allow access to Site Verification"
				}
			]
		},
		{
			"name": "rep-01-picker",
			"url": "/administrator/index.php?option=com_sitekit&view=reports",
			"actions": [
				{
					"select": [
						"#sitekit-report-picker",
						"searchconsole"
