			]
		},
		{
			"name": "dash-04-features",
			"url": "/administrator/index.php?option=com_sitekit&view=dashboard",
			"highlights": [
				{
					"selector": ".com-sitekit-dashboard > .card:last-child",
					"label": "4",
					"note": "State of each Google service"
				}
			]
		},
		{
			"name": "trial-01-start",
			"url": "/administrator/index.php?option=com_sitekit&view=settings",
			"highlights": [
				{
					"selector": "a[href*=\"task=oauth.trialStart\"]",
					"label": "1",
					"note": "Start the free trial"
				}
			]
		},
		{
			"name": "services-00-not-connected",
			"url": "/administrator/index.php?option=com_sitekit&view=services",
			"highlights": [
				{
					"selector": ".com-sitekit-services > .alert",
					"label": "",
					"note": "Connect Google first"
				}
			]
		},
		{
			"name": "reports-00-not-connected",
			"url": "/administrator/index.php?option=com_sitekit&view=reports",
			"highlights": [
				{
					"selector": ".com-sitekit-reports > .alert",
					"label": "",
					"note": "Connect Google first"
				}
			]
		},
		{
			"name": "byo-05-connected",
			"url": "/administrator/index.php?option=com_sitekit&view=settings",
			"blur": [
				"#client_id"
			],
			"highlights": [
				{
					"selector": ".col-lg-4 > .card:first-child",
					"label": "5",
					"note": "Connected, with your Google account"
				}
			]
		},
		{
			"name": "sc-01-card",
			"url": "/administrator/index.php?option=com_sitekit&view=services",
			"highlights": [
				{
					"selector": ".card:has(input[name=feature][value=searchconsole])",
					"label": "1",
					"note": "The Search Console card"
				}
			]
		},
		{
			"name": "sc-02-property",
			"url": "/administrator/index.php?option=com_sitekit&view=services",
			"actions": [
				{
					"select": [
						"select[name=site_url]",
						"https://thepixel.dev/"
