					"padding": 4,
					"note": "Optional: one page only"
				},
				{
					"selector": "[data-sitekit-load-report]",
					"label": "2c",
					"padding": 4,
					"note": "Load the report"
				}
			]
		},
		{
			"name": "plg-01-plugins",
			"url": "/administrator/index.php?option=com_plugins&view=plugins&filter[search]=sitekit",
			"highlights": [
				{
					"selector": "#filter_search",
					"label": "1a",
					"padding": 4,
					"note": "Search for sitekit"
				},
				{
					"selector": "#pluginList",
					"label": "1b",
					"note": "The five SiteKit plugins"
				}
			]
		},
		{
			"name": "perm-01-options",
			"url": "/administrator/index.php?option=com_sitekit&view=dashboard",
			"highlights": [
