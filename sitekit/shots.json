			],
			"highlights": [
				{
					"selector": ".com-sitekit-report-card:not([hidden]) .com-sitekit-metric-grid",
					"label": "5a",
					"note": "Totals and change"
				},
				{
					"selector": ".com-sitekit-report-card:not([hidden]) .com-sitekit-chart-panel",
					"label": "5b",
					"note": "Users and sessions per day"
				},
				{
