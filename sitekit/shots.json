				}
			],
			"highlights": [
				{
					"selector": "form:has(input[value=searchconsole]) select[name=site_url]",
					"label": "2a",
					"padding": 4,
					"note": "Choose your site's property"
				},
				{
					"selector": "form:has(input[value=searchconsole]) button[type=submit]",
					"label": "2b",
					"padding": 4,
					"note": "Save the property"
				}
			]
		},
		{
			"name": "ga-01-authorize",
			"url": "/administrator/index.php?option=com_sitekit&view=services",
			"highlights": [
				{
					"selector": "a[href*=\"task=oauth.authorize\"][href*=\"feature=analytics\"]",
					"label": "1",
					"padding": 4,
					"note": "Allow access to Analytics"
				}
			]
		},
		{
			"name": "gtm-01-container",
			"url": "/administrator/index.php?option=com_sitekit&view=services",
			"actions": [
				{
					"fill": [
						"input[name=container_id]",
						"GTM-ABC1234"
					]
				}
			],
			"highlights": [
				{
					"selector": "form:has(input[value=tagmanager]) input[name=container_id]",
					"label": "1a",
					"padding": 4,
					"note": "Enter your GTM container ID"
				},
				{
					"selector": "form:has(input[value=tagmanager]) button[type=submit]",
					"label": "1b",
					"padding": 4,
					"note": "Save the container ID"
				}
			]
		},
		{
			"name": "ver-01-authorize",
			"url": "/administrator/index.php?option=com_sitekit&view=services",
			"highlights": [
				{
					"selector": "a[href*=\"task=oauth.authorize\"][href*=\"feature=verification\"]",
					"label": "1",
