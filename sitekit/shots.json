					"wait_ms": 300
				}
			],
			"highlights": [
				{
					"selector": "#sitekit-report-picker",
					"label": "1",
					"padding": 4,
					"note": "Choose a report"
				}
			]
		},
		{
			"name": "rep-02-filters",
			"url": "/administrator/index.php?option=com_sitekit&view=reports",
			"actions": [
				{
					"select": [
						"#sitekit-report-picker",
