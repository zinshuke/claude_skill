{
	"base_url": "http://localhost:3000",
	"viewport": {
		"width": 1440,
		"height": 900
	},
	"color": "#e5262f",
	"crop": {
		"padding": 60,
		"min_width": 800,
		"min_height": 400
	},
	"hide": [
		".phpdebugbar",
		"#system-debug"
	],
	"blur": [],
	"redact": [
		"properties/\\d+",
		"\\d{8,}-[a-z0-9]{24,}\\.apps\\.googleusercontent\\.com"
	],
	"shots": [
		{
			"name": "byo-01-redirect-uri",
			"url": "/administrator/index.php?option=com_sitekit&view=settings",
			"highlights": [
				{
					"selector": ".mb-3:has(#redirect_uri)",
					"label": "1",
					"note": "Copy this redirect URI"
				}
			]
		},
		{
			"name": "byo-02-credentials",
			"url": "/administrator/index.php?option=com_sitekit&view=settings",
			"actions": [
				{
					"fill": [
						"#client_id",
						"123456789012-abc123def456.apps.googleusercontent.com"
					]
				},
				{
					"fill": [
						"#client_secret",
						"GOCSPX-example-secret"
					]
				}
			],
			"highlights": [
				{
					"selector": ".mb-3:has(#client_id)",
					"label": "2a",
					"note": "Paste the Client ID"
				},
				{
					"selector": ".mb-3:has(#client_secret)",
					"label": "2b",
					"note": "Paste the Client secret"
				},
				{
					"selector": "#adminForm button[type=submit]",
					"label": "2c",
					"note": "Save",
					"color": "#16a34a"
				}
			]
		}
	]
}
